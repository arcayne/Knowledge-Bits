---
import { createCsrfToken, REVIEW_CSRF_COOKIE } from '../operator-auth.mjs';

const csrfToken = Astro.cookies.get(REVIEW_CSRF_COOKIE)?.value ?? createCsrfToken();
Astro.cookies.set(REVIEW_CSRF_COOKIE, csrfToken, {
  httpOnly: true,
  sameSite: 'strict',
  secure: import.meta.env.PROD,
  path: '/',
});

const runId = Astro.url.searchParams.get('runId');
if (runId) return Astro.redirect(`/runs/${encodeURIComponent(runId)}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="review-csrf-token" content={csrfToken} />
    <title>Knowledge Bits pipeline</title>
    <style>
      :root { color: #18211e; background: #f4f7f2; font-family: Arial, sans-serif; }
      body { margin: 0; }
      main { max-width: 1100px; margin: 0 auto; padding: 2rem 1.25rem 3rem; }
      header { display: flex; align-items: start; justify-content: space-between; gap: 1rem; border-bottom: 1px solid #c8d1c8; padding-bottom: 1rem; }
      h1, h2, h3, p { margin-top: 0; }
      h1 { font-size: 1.65rem; margin-bottom: .4rem; }
      h2 { font-size: 1rem; margin: 1.5rem 0 .75rem; color: #315247; }
      h3 { font-size: 1rem; margin-bottom: .4rem; }
      button, a { font: inherit; }
      button { border: 1px solid #739486; border-radius: .3rem; background: #fff; color: #173c31; padding: .45rem .7rem; cursor: pointer; }
      button[aria-pressed="true"] { background: #174c3d; border-color: #174c3d; color: #fff; }
      #daily-progress { margin: 1.25rem 0; border: 1px solid #a9b9ad; border-radius: .55rem; background: #fff; padding: 1rem; }
      #new-nuglet { margin: 1.25rem 0; border: 1px solid #a9b9ad; border-radius: .55rem; background: #fff; padding: 1rem; }
      #new-nuglet h2 { margin: 0 0 .35rem; color: #173c31; }
      #new-nuglet > p { color: #52655d; font-size: .88rem; }
      .intake-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; }
      .intake-field { display: grid; gap: .3rem; }
      .intake-field.full { grid-column: 1 / -1; }
      .intake-field label { color: #315247; font-size: .82rem; font-weight: 700; }
      .intake-field input, .intake-field textarea { box-sizing: border-box; width: 100%; border: 1px solid #a9b9ad; border-radius: .3rem; padding: .55rem .65rem; color: #18211e; background: #fbfdfb; font: inherit; }
      .intake-field textarea { min-height: 4.2rem; resize: vertical; }
      .intake-field small { color: #52655d; font-size: .78rem; }
      .intake-actions { display: flex; align-items: center; gap: .75rem; margin-top: .85rem; }
      #new-nuglet-submit { background: #174c3d; border-color: #174c3d; color: #fff; font-weight: 700; }
      #new-nuglet-submit:disabled { cursor: wait; opacity: .65; }
      #new-nuglet-status, #nuglet-similarity-status { margin: 0; color: #315247; font-size: .88rem; }
      #new-nuglet-status[data-tone="error"] { color: #8e271d; }
      #new-nuglet-status a { color: #124f8d; font-weight: 700; }
      #nuglet-similarity-results { margin-top: .85rem; border: 1px solid #c8d1c8; border-radius: .4rem; background: #f8fbf8; padding: .75rem; }
      #nuglet-similarity-results[data-risk="related"], #nuglet-similarity-results[data-risk="likely_duplicate"] { border-color: #d77d59; background: #fff7f2; }
      #nuglet-similarity-results h3 { margin-bottom: .45rem; }
      #nuglet-similarity-matches { margin: 0; padding-left: 1.25rem; }
      #nuglet-similarity-matches li + li { margin-top: .45rem; }
      #nuglet-similarity-matches a { color: #124f8d; font-weight: 700; }
      #nuglet-distinct-confirmation { display: flex; align-items: start; gap: .5rem; margin-top: .7rem; color: #6d3b28; font-size: .85rem; }
      .daily-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; }
      .daily-heading h2 { margin: 0; font-size: 1.15rem; color: #173c31; }
      .daily-heading p { margin: 0; color: #52655d; font-size: .85rem; }
      .target-progress { height: .65rem; margin: .8rem 0 1rem; overflow: hidden; border-radius: 999px; background: #dfe7e1; }
      .target-progress > span { display: block; height: 100%; border-radius: inherit; background: #2f7a61; }
      .daily-metrics { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: .65rem; }
      .daily-metrics > div { min-width: 0; border-left: 3px solid #b7c9bd; padding: .2rem .65rem; }
      .daily-metrics strong, .daily-metrics span { display: block; }
      .daily-metrics strong { font-size: 1.35rem; color: #173c31; }
      .daily-metrics span { margin-top: .15rem; color: #52655d; font-size: .8rem; }
      .latest-run { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: .2rem .65rem; align-items: baseline; border-top: 1px solid #d9e0da; margin-top: 1rem; padding-top: .85rem; }
      .latest-run strong { color: #315247; font-size: .8rem; text-transform: uppercase; }
      .latest-run a { color: #124f8d; font-weight: 700; }
      .latest-run p { grid-column: 2; margin: 0; color: #52655d; font-size: .8rem; }
      #operations { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .75rem; margin: 1.25rem 0; }
      #operations article { border: 1px solid #c8d1c8; border-radius: .45rem; background: #fff; padding: .85rem; }
      #operations article[data-operation="blockers"] { border-color: #d77d59; background: #fff7f2; }
      #operations h2 { margin: 0 0 .35rem; }
      #operations p { margin-bottom: 0; color: #52655d; font-size: .88rem; }
      #status-counts { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: .65rem; margin: 1.25rem 0 .75rem; }
      #status-counts > div { min-width: 0; border: 1px solid #c8d1c8; border-radius: .4rem; background: #fff; padding: .7rem; }
      #status-counts > div[data-status-count="needsHuman"] { border-color: #d77d59; background: #fff7f2; }
      #status-counts strong, #status-counts span { display: block; }
      #status-counts strong { font-size: 1.35rem; color: #173c31; }
      #status-counts span { color: #52655d; font-size: .8rem; margin-top: .15rem; }
      #stage-counts { display: grid; grid-template-columns: repeat(6, minmax(0, 1fr)); gap: .75rem; margin: 1.25rem 0; }
      #stage-counts > div { min-width: 0; border: 1px solid #c8d1c8; border-radius: .4rem; background: #fff; padding: .75rem; }
      #stage-counts strong, #stage-counts span { display: block; }
      #stage-counts strong { font-size: 1.4rem; color: #173c31; }
      #stage-counts span { color: #52655d; font-size: .85rem; margin-top: .2rem; }
      #pipeline-runs { background: #fff; border: 1px solid #c8d1c8; border-radius: .45rem; padding: 0 1rem 1rem; }
      #pipeline-runs > section { border-top: 1px solid #d9e0da; padding: .2rem 0 1rem; }
      #pipeline-runs > section:first-child { border-top: 0; }
      .group-description { color: #52655d; font-size: .88rem; margin: -.35rem 0 .75rem; }
      .run-list { display: grid; gap: .65rem; }
      [data-run-row] { display: grid; grid-template-columns: minmax(0, 1fr) auto; column-gap: 1rem; align-items: center; border: 1px solid #d9e0da; border-radius: .35rem; padding: .85rem; }
      [data-run-row] p { color: #52655d; margin-bottom: 0; }
      .run-badges { display: flex; flex-wrap: wrap; gap: .35rem; margin-top: .45rem; }
      .run-badge { border-radius: 999px; background: #edf3ee; color: #315247; padding: .2rem .5rem; font-size: .75rem; }
      .run-badge[data-tone="warning"] { background: #fff0e8; color: #853e20; }
      [data-run-row] .run-reason { grid-column: 1 / -1; color: #853e20; }
      [data-run-row] .run-duplicate { grid-column: 1 / -1; color: #6d5a32; }
      [data-run-row] a { color: #124f8d; font-weight: 700; }
      #pipeline-error { color: #8e271d; }
      @media (max-width: 720px) { header { display: block; } header [aria-label] { margin-top: 1rem; } .daily-heading { display: block; } .daily-heading p { margin-top: .35rem; } .daily-metrics, #status-counts, #stage-counts, #operations { grid-template-columns: repeat(2, minmax(0, 1fr)); } .latest-run { grid-template-columns: 1fr; } .latest-run p { grid-column: 1; } [data-run-row] { grid-template-columns: 1fr; } [data-run-row] a { margin-top: .75rem; } }
      @media (max-width: 620px) { .intake-grid { grid-template-columns: 1fr; } .intake-field.full { grid-column: auto; } .intake-actions { align-items: start; flex-direction: column; } }
    </style>
  </head>
  <body>
    <main id="pipeline-page">
      <header>
        <div><h1>Knowledge Bits pipeline</h1><p id="pipeline-summary">Loading current runs...</p></div>
        <button type="button" id="pipeline-refresh">Refresh</button>
        <div aria-label="Pipeline filters">
          <button type="button" data-filter="all" aria-pressed="true">All</button>
          <button type="button" data-filter="blocked" aria-pressed="false">Blocked</button>
          <button type="button" data-filter="retrying" aria-pressed="false">Retrying</button>
          <button type="button" data-filter="needs_human" aria-pressed="false">Needs attention</button>
          <button type="button" data-filter="deliver" aria-pressed="false">Delivering</button>
          <button type="button" data-filter="completed" aria-pressed="false">Completed</button>
          <button type="button" data-filter="rejected" aria-pressed="false">Rejected</button>
          <button type="button" data-filter="duplicate" aria-pressed="false">Duplicates</button>
        </div>
      </header>
      <section id="new-nuglet" aria-labelledby="new-nuglet-heading">
        <h2 id="new-nuglet-heading">Start a new Nuglet</h2>
        <p>Check the idea against every existing run first. If it is distinct, create a fresh NotebookLM notebook and start Research.</p>
        <form id="new-nuglet-form">
          <div class="intake-grid">
            <div class="intake-field full"><label for="nuglet-title">Title</label><input id="nuglet-title" name="title" required placeholder="Why you can't focus after short videos" /></div>
            <div class="intake-field"><label for="nuglet-objective">What should it help someone understand or do?</label><textarea id="nuglet-objective" name="objective" required placeholder="Explain the idea and give one practical action."></textarea></div>
            <div class="intake-field"><label for="nuglet-audience">Audience</label><input id="nuglet-audience" name="audience" required value="general adult learners" /></div>
            <div class="intake-field"><label for="nuglet-notebook">Fresh NotebookLM notebook ID</label><input id="nuglet-notebook" name="notebookLmNotebookId" required placeholder="Create Nuglet: &lt;title&gt; after the similarity check" /><small>A new Nuglet always gets a new notebook. Existing notebooks belong to their existing runs.</small></div>
            <div class="intake-field"><label for="nuglet-locale">Locale</label><input id="nuglet-locale" name="locale" required value="en" /></div>
            <div class="intake-field full"><label for="nuglet-sources">Starting source URLs <span>(optional, one per line)</span></label><textarea id="nuglet-sources" name="sourceUrls" placeholder="https://...\nhttps://..."></textarea></div>
          </div>
          <div class="intake-actions"><button id="nuglet-similarity-check" type="button">Check for similar Nuglets</button><p id="nuglet-similarity-status" role="status" aria-live="polite">Run this check before creating the notebook.</p></div>
          <section id="nuglet-similarity-results" aria-live="polite" hidden>
            <h3 id="nuglet-similarity-heading"></h3>
            <ul id="nuglet-similarity-matches"></ul>
            <label id="nuglet-distinct-confirmation" hidden><input type="checkbox" name="confirmDistinct" />I reviewed these matches and this Nuglet has a deliberately distinct learner objective or angle.</label>
          </section>
          <div class="intake-actions"><button id="new-nuglet-submit" type="submit" disabled>Start research</button><p id="new-nuglet-status" role="status" aria-live="polite"></p></div>
        </form>
      </section>
      <section id="daily-progress" aria-label="Daily delivery target"></section>
      <section id="operations" aria-label="Pipeline operations"></section>
      <section id="status-counts" aria-label="Pipeline status"></section>
      <section id="stage-counts" aria-label="Pipeline stages"></section>
      <section id="pipeline-runs" aria-live="polite"></section>
      <p id="pipeline-error" role="alert" hidden></p>
    </main>
    <script>
      import { mountPipelinePage } from '../pipeline-client.mjs';
      mountPipelinePage();
    </script>
  </body>
</html>
