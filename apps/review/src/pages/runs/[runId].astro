---
import { createCsrfToken, REVIEW_CSRF_COOKIE } from '../../operator-auth.mjs';

const { runId } = Astro.params;
const csrfToken = Astro.cookies.get(REVIEW_CSRF_COOKIE)?.value ?? createCsrfToken();
Astro.cookies.set(REVIEW_CSRF_COOKIE, csrfToken, {
  httpOnly: true,
  sameSite: 'strict',
  secure: import.meta.env.PROD,
  path: '/',
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="review-csrf-token" content={csrfToken} />
    <title>Content review</title>
    <style>
      :root { color: #15211e; background: #f5f7f5; font-family: Arial, sans-serif; }
      body { margin: 0; padding-bottom: 9rem; }
      main { max-width: 1100px; margin: 0 auto; padding: 2rem 1.25rem; }
      header { display: flex; justify-content: space-between; gap: 1rem; align-items: baseline; border-bottom: 1px solid #b9c6c0; padding-bottom: 1rem; }
      h1, h2, h3, h4, p { margin-top: 0; }
      h1 { font-size: 1.45rem; }
      h2 { font-size: 1rem; margin-bottom: .75rem; }
      h3 { font-size: 1.2rem; }
      h4 { font-size: .8rem; text-transform: uppercase; color: #46625b; }
      .status, .muted { color: #596a64; }
      .status { font-size: .875rem; }
      .review-grid { display: grid; grid-template-columns: minmax(0, 1.5fr) minmax(260px, .8fr); gap: 1.25rem; margin-top: 1.25rem; }
      .review-section { border-top: 2px solid #3b665a; padding-top: .75rem; margin-bottom: 1.25rem; }
      .review-section ul { padding-left: 1.15rem; }
      .lesson-field { border-bottom: 1px solid #d8dfdc; margin-bottom: .9rem; padding-bottom: .9rem; }
      .asset { border: 1px solid #b9c6c0; min-height: 6rem; padding: .75rem; margin-bottom: .75rem; background: #fff; }
      .asset img, .asset audio { display: block; max-width: 100%; width: 100%; }
      button:disabled { cursor: not-allowed; opacity: .45; }
      .decision-bar { position: fixed; inset: auto 0 0; background: #10251f; color: #fff; border-top: 1px solid #0b1a16; padding: .75rem 1.25rem; }
      .decision-inner { max-width: 1100px; margin: 0 auto; display: flex; align-items: center; gap: .75rem; flex-wrap: wrap; }
      button { border: 1px solid transparent; padding: .55rem .8rem; font: inherit; cursor: pointer; }
      button[data-decision="approve"] { background: #c8ee78; color: #142119; }
      button[data-decision="request_changes"] { background: transparent; color: #fff; border-color: #c5d2cd; }
      #change-form { display: none; flex: 1 1 100%; gap: .5rem; align-items: end; }
      #change-form[data-open="true"] { display: flex; }
      textarea { flex: 1; min-height: 3.5rem; font: inherit; }
      #error { color: #9b2424; }
      @media (max-width: 720px) { .review-grid { grid-template-columns: 1fr; } header { display: block; } }
    </style>
  </head>
  <body>
    <main data-run-id={runId}>
      <header>
        <div><h1 id="title">Content review</h1><p class="status" id="status">Loading review data...</p></div>
        <p class="status" id="checksum">Checksum unavailable</p>
      </header>
      <p id="error" role="alert" hidden></p>
      <div class="review-grid" id="review" hidden>
        <section>
          <section class="review-section" id="learner-preview">
            <h2>Learner preview</h2>
            <h3 data-content-path="title">Missing learner preview</h3>
            <div class="lesson-field"><h4>Takeaway</h4><p data-content-path="takeaway"></p></div>
            <div class="lesson-field"><h4>Action</h4><p data-content-path="action"></p></div>
            <div class="lesson-field"><h4>Quick</h4><p data-content-path="depths.quick"></p></div>
            <div class="lesson-field"><h4>Core</h4><p data-content-path="depths.core"></p></div>
            <div class="lesson-field"><h4>Deep</h4><p data-content-path="depths.deep"></p></div>
            <h4>Claim coverage</h4><ul id="claim-coverage"></ul>
          </section>
          <section class="review-section">
            <h2>Evidence</h2>
            <h4>Accepted sources</h4><ul id="accepted-sources"></ul>
            <h4>Rejected sources</h4><ul id="rejected-sources"></ul>
            <h4>Coverage gaps</h4><ul id="coverage-gaps"></ul>
            <h4>Claims and citations</h4><ul id="claims"></ul>
          </section>
          <section class="review-section"><h2>QA</h2><p id="qa" class="muted">Loading QA status...</p><ul id="qa-findings"></ul></section>
        </section>
        <aside aria-label="Generated assets">
          <section class="review-section"><h2>Hero</h2><div class="asset" id="hero">Missing hero preview.</div></section>
          <section class="review-section"><h2>Infographic</h2><div class="asset" id="infographic">Missing infographic preview.</div></section>
          <section class="review-section"><h2>Audio</h2><div class="asset" id="audio">Missing audio preview.</div></section>
        </aside>
      </div>
    </main>
    <footer class="decision-bar" aria-label="Overall review decision">
      <div class="decision-inner">
        <span id="decision-status">One overall package decision</span>
        <button type="button" data-decision="approve" disabled>Approve</button>
        <button type="button" data-decision="request_changes" disabled>Request changes</button>
        <form id="change-form">
          <label for="comment">Required comment</label>
          <textarea id="comment" name="comment" required></textarea>
          <button type="submit" disabled>Send changes</button>
        </form>
      </div>
    </footer>
    <script>
      import { mountReviewPage } from '../../review-client.mjs';
      mountReviewPage();
    </script>
  </body>
</html>
