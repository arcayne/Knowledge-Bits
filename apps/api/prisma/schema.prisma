generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Run {
  id              String     @id @default(uuid())
  title           String
  locale          String
  brief           Json
  currentStage    String
  currentRevision Int        @default(1)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  stages          Stage[]
  jobs            Job[]
  artifacts       Artifact[]
  reviews         Review[]
  deliveries      Delivery[]
}

model Stage {
  id        String   @id @default(uuid())
  runId     String
  name      String
  state     String
  reason    String?
  attempt   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  run       Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, name])
}

model Job {
  id             String   @id @default(uuid())
  runId          String
  stage          String
  action         String
  state          String
  idempotencyKey String   @unique
  availableAt    DateTime @default(now())
  leaseOwner     String?
  leaseExpiresAt DateTime?
  attempt        Int      @default(0)
  input          Json
  result         Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  run            Run      @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([state, availableAt])
}

model Artifact {
  id            String   @id @default(uuid())
  runId         String
  revision      Int
  kind          String
  mediaType     String
  checksum      String
  storageKey    String   @unique
  byteSize      Int
  provenance    Json
  inputChecksum String?
  createdAt     DateTime @default(now())
  run           Run      @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@index([runId, revision, kind])
}

model Review {
  id              String   @id @default(uuid())
  runId           String
  revision        Int
  packageChecksum String
  decision        String
  reviewerId      String
  comment         String?
  createdAt       DateTime @default(now())
  run             Run      @relation(fields: [runId], references: [id], onDelete: Restrict)

  @@unique([runId, revision, packageChecksum])
}

model Delivery {
  id              String   @id @default(uuid())
  runId           String
  target          String
  packageChecksum String
  idempotencyKey  String   @unique
  state           String
  attempts        Int      @default(0)
  response        Json?
  nextAttemptAt   DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  run             Run      @relation(fields: [runId], references: [id], onDelete: Restrict)
}
