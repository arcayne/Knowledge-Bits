# Local filesystem roots are worker-only configuration. Runs and artifacts store
# recipe identity, version, checksum, and canonical bytes, never these paths.
PRODUCT_RECIPE_ROOTS='{"nuglet.lesson.v1":"/absolute/path/to/nuglet/apps/nuglet-lab/recipes/nuglet.lesson.v1"}'
# Maximum time allowed for each NotebookLM CLI command. Source import can take
# longer than a normal API request when a notebook has many URLs.
