ENGINE_DATABASE_URL=""
ENGINE_MIGRATION_DATABASE_URL=""
TEST_DATABASE_URL=""
ENGINE_API_TOKEN=""
ENGINE_REVIEW_TOKEN=""
ENGINE_API_URL=""
ENGINE_API_BASE_URL=""
# Used only by the Mac local supervisor. It deliberately overrides the shared
# deployed API URL so provider work stays on the local control service.
KNOWLEDGE_BITS_LOCAL_API_URL="http://127.0.0.1:3000"
REVIEW_AUTH_JWKS_URL=""
REVIEW_AUTH_ISSUER=""
REVIEW_AUTH_AUDIENCE=""
REVIEW_AUTH_HEADER="Cf-Access-Jwt-Assertion"
REVIEW_AUTH_REQUIRED_GROUP=""
REVIEW_PUBLIC_ORIGIN=""
# Nuglet: https://api.nuglet.app/internal/knowledge-bits
DELIVERY_ADAPTER_URL=""
# Must match Nuglet backend KNOWLEDGE_BITS_IMPORT_TOKEN.
DELIVERY_ADAPTER_TOKEN=""
ENGINE_WORKER_CREDENTIALS='[{"token":"replace-with-worker-token","workerId":"research-worker","capabilities":["collect_sources"]}]'
# One supervisor invocation stays focused on the selected run and advances as
# many immediately eligible stages as these bounds allow.
ENGINE_WORKER_LEASE_SECONDS="90"
ENGINE_WORKER_MAX_JOBS_PER_TICK="6"
ENGINE_WORKER_TICK_SECONDS="2700"
ARTIFACT_STORAGE_MODE="unavailable"
ARTIFACT_STORAGE_FILESYSTEM_ROOT=""
ARTIFACT_STORAGE_R2_ACCOUNT_ID=""
ARTIFACT_STORAGE_R2_BUCKET="nuglet-media-prod"
ARTIFACT_STORAGE_R2_ACCESS_KEY_ID=""
ARTIFACT_STORAGE_R2_SECRET_ACCESS_KEY=""
WORKER_PROVIDER_MODE="production"
# Local filesystem roots are worker-only configuration. Runs and artifacts store
# recipe identity, version, checksum, and canonical bytes, never these paths.
PRODUCT_RECIPE_ROOTS='{"nuglet.lesson.v1":"/absolute/path/to/knowledge-bits/recipes/nuglet.lesson.v1"}'
# Maximum time allowed for each NotebookLM CLI command. Source import can take
# longer than a normal API request when a notebook has many URLs.
NOTEBOOKLM_TIMEOUT_MS="180000"
PI_PROVIDER=""
PI_MODEL=""
# Grounded source discovery reuses the Google Vertex model and ADC configured
# for Pi editorial QA. Research accepts at most this many seed + discovered URLs
# and stops for human review unless the minimum number survives retrieval.
PI_SOURCE_DISCOVERY_MAX_CANDIDATES="8"
PI_SOURCE_DISCOVERY_MIN_ACCEPTED="3"
PI_TIMEOUT_MS="60000"
# Public source retrieval is bounded independently from model inference.
SOURCE_FETCH_TIMEOUT_MS="20000"
SOURCE_SNAPSHOT_MAX_BYTES="2000000"
SOURCE_PDF_SNAPSHOT_MAX_BYTES="10000000"
# Optional comma-separated allowlist. Hosts here skip public DNS checks.
SOURCE_TRUSTED_HOSTS=""
MEDIA_GENERATION_COMMAND="/opt/homebrew/bin/node"
MEDIA_GENERATION_ARGS='["/absolute/path/to/knowledge-bits/apps/worker/scripts/nuglet-media-command.mjs"]'
# Deterministic NotebookLM Short post-production. Defaults use PATH when empty.
FFMPEG_COMMAND=""
FFPROBE_COMMAND=""
PANGO_VIEW_COMMAND=""
NUGLET_LEGACY_REUSE_ROOT=""
