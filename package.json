{
  "name": "knowledge-bits",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "pnpm test:contracts && turbo run test --concurrency=1 && pnpm test:e2e",
    "test:contracts": "node --test test/deployment-contracts.test.mjs test/credential-scanner.test.mjs",
    "test:e2e": "node --test test/e2e/*.test.mjs",
    "scan:forbidden-credentials": "node scripts/scan-forbidden-credentials.mjs",
    "dev": "turbo run dev",
    "prisma:generate": "pnpm --filter @knowledge-bits/api prisma:generate"
  },
  "devDependencies": {
    "turbo": "2.9.18",
    "typescript": "6.0.3"
  }
}
